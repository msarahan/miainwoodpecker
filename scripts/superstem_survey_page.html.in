<title>SuperSTEM Instrument Survey</title>
<style>
  :root {
    --ground: #f6f8f9;
    --surface: #ffffff;
    --raised: #eef3f5;
    --ink: #152029;
    --muted: #5b6e7d;
    --accent: #0e6b74;
    --accent-soft: #dcecee;
    --caution: #9c5d12;
    --caution-soft: #f7eddc;
    --border: #dbe3e8;
    --shadow: 0 1px 2px rgba(21, 32, 41, .06), 0 8px 24px rgba(21, 32, 41, .05);
    --serif: ui-serif, "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --sans: ui-sans-serif, system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, "Cascadia Mono", Consolas, "SF Mono", Menlo, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #0d1317;
      --surface: #141d23;
      --raised: #1b262d;
      --ink: #e3ebf0;
      --muted: #93a6b2;
      --accent: #54c3cb;
      --accent-soft: #10333a;
      --caution: #dda05a;
      --caution-soft: #2e2417;
      --border: #243138;
      --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 8px 24px rgba(0, 0, 0, .3);
    }
  }
  :root[data-theme="dark"] {
    --ground: #0d1317;
    --surface: #141d23;
    --raised: #1b262d;
    --ink: #e3ebf0;
    --muted: #93a6b2;
    --accent: #54c3cb;
    --accent-soft: #10333a;
    --caution: #dda05a;
    --caution-soft: #2e2417;
    --border: #243138;
    --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 8px 24px rgba(0, 0, 0, .3);
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16.5px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  .wrap {
    max-width: 46rem;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  header { display: flex; flex-direction: column; gap: .85rem; }
  .eyebrow {
    font-size: .72rem;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 650;
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(2.1rem, 5.5vw, 2.9rem);
    line-height: 1.12;
    margin: 0;
    font-weight: 600;
    letter-spacing: -.015em;
    text-wrap: balance;
  }
  .standfirst { margin: 0; color: var(--muted); font-size: 1.06rem; max-width: 34rem; }

  section { display: flex; flex-direction: column; gap: .9rem; }
  h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    margin: 0;
    font-weight: 600;
    letter-spacing: -.01em;
    text-wrap: balance;
  }
  h3 { font-size: .95rem; margin: 0; font-weight: 650; letter-spacing: .005em; }
  p { margin: 0; }
  a { color: var(--accent); text-underline-offset: 2px; }
  strong { font-weight: 650; }
  hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: .25rem 0;
    width: 100%;
  }

  /* ---- the download panel: the reason this page exists ---- */
  .get {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .filemeta {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem 1.1rem;
    font-size: .82rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .filemeta code { background: none; padding: 0; color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; }
  button, .actions a {
    font: inherit;
    font-size: .93rem;
    font-weight: 600;
    border-radius: 7px;
    padding: .6rem 1.15rem;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background .12s ease, border-color .12s ease;
    display: inline-block;
    text-decoration: none;
  }
  .primary { background: var(--accent); color: var(--ground); }
  .primary:hover { filter: brightness(1.08); }
  .secondary { background: transparent; color: var(--ink); border-color: var(--border); }
  .secondary:hover { background: var(--raised); }
  button:focus-visible, a:focus-visible, summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  button[disabled] { opacity: .5; cursor: not-allowed; }
  #status { font-size: .87rem; color: var(--muted); min-height: 1.3em; }
  #status.ok { color: var(--accent); }
  #status.warn { color: var(--caution); }

  /* ---- commands ---- */
  pre.cmd {
    background: var(--raised);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: .8rem 1rem;
    margin: 0;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: .87rem;
    line-height: 1.55;
  }
  code {
    font-family: var(--mono);
    font-size: .87em;
    background: var(--raised);
    padding: .12em .38em;
    border-radius: 4px;
  }

  /* ---- callouts ---- */
  .note {
    border-left: 3px solid var(--caution);
    background: var(--caution-soft);
    border-radius: 0 7px 7px 0;
    padding: .85rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    font-size: .95rem;
  }
  .note .lede { color: var(--caution); font-weight: 650; }

  /* ---- runs ---- */
  .run {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 10px;
    padding: 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: .8rem;
  }
  .runhead { display: flex; align-items: baseline; gap: .8rem; flex-wrap: wrap; }
  .runno {
    font-family: var(--mono);
    font-size: .78rem;
    color: var(--accent);
    background: var(--accent-soft);
    padding: .16rem .5rem;
    border-radius: 4px;
